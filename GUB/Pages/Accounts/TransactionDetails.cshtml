@page
@model GUB.Pages.Accounts.TransactionDetailsModel
@{
}


<section class="p-0">
    <div class="page-title" data-aos="fade">
        <div class="heading">
            <div class="container">
                <div class="row d-flex justify-content-center text-center">
                    <div class="col-lg-8">
                        <h1 class="display-4 fw-bold text-white text-uppercase">
                            Greater Unity Bank
                        </h1>
                        @foreach (var q in Model.ZenQuotes)
                        {
                            <p class="mb-0 p-3 border-start border-primary fs-5 fst-italic text-secondary">
                                "@q.Quote"
                                <span class="d-block text-end fw-bold text-dark">- @q.Author</span>
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>


        <div class="table-container" style="background-color: #f5f7fa;">

            <div class="mask d-flex align-items-center flex-column">
                    <div class="d-flex justify-content-center mt-4">
                        <h2 class="text-uppercase border-bottom text-muted">Transactions History</h2>
                    </div>
                <div class="container">
                    <br />
                    <div>
                        <h3 class=" text-dark float-left">Account ID: @Model.AccountId </h3>
                        <a class="btn btn-success float-right " asp-area="" asp-page="/Accounts/AccountIndex">&lArr; Back </a>

                    </div>
                </div>

                <div class="h-100 mb-5 w-60">
                    <div class="row justify-content-center">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body p-0">
                                    <div class="table-responsive table-scroll" data-mdb-perfect-scrollbar="true" style="position: relative; height: 700px">
                                        <table class="table table-striped" id="posts-table">
                                            <thead class="thead-green">
                                                <tr>
                                                    @* transaction id *@
                                                    <th scope="col">
                                                        Trans. ID
                                                    </th>                                                                                                 
                                                    @* Date *@
                                                    <th scope="col">
                                                        Date                   
                                                    </th>
                                                    @* Type *@
                                                    <th scope="col">
                                                        Type
                                                    </th>
                                                    @* Operation *@
                                                    <th scope="col">
                                                        Operation
                                                    </th>
                                                    @* Amount *@
                                                    <th scope="col">
                                                        Amount
                                                    </th>
                                                    @* Balance *@
                                                    <th scope="col">
                                                        Balance
                                                    </th>
                                                    @* Symbol *@
                                                    <th scope="col">
                                                        Symbol
                                                    </th>
                                                    @* Account *@
                                                    <th scope="col">
                                                        Account
                                                    </th>
                                                    @* Bank *@
                                                    <th scope="col">
                                                        Bank
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>

                                            </tbody>
                                        </table>
                                        <div class="d-flex justify-content-center mb-3">

                                        <a class="btn btn-success" href="javascript:showMore();">Show More</a>
                                            
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
</section>
@section Scripts
{
    <script>
        let pageNo = 1;

        document.addEventListener("DOMContentLoaded", function () {
            showMore();
        });

        function showMore() {
            fetch("TransactionDetails?handler=ShowMore&pageNo=" + pageNo + "&id=@Model.AccountId")
                .then((response) => response.json())
                .then((json) => {
                    pageNo++;
                    json.transa.forEach(drawElements);
                });
        }

        function drawElements(element) {
            document.querySelector('#posts-table tbody').innerHTML +=
                `<tr>
                    <td>${element.transactionId}</td>
                    <td>${element.date}</td>
                    <td>${element.type}</td>
                    <td>${element.operation}</td>
                    <td>${element.amount}</td>
                    <td>${element.balance}</td>
                    <td>${element.symbol}</td>
                    <td>${element.account}</td>
                    <td>${element.bank}</td>
                </tr>`;
        }
    </script>
}
