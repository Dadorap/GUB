@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}



<section class="ftco-section min-vh-100 min-vw-100 section hero dark-background">
    <img src="~/img/hero-bg.png" alt="" data-aos="fade-in">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 text-center mb-5">
                <h2 class="heading-section">Greater Unity Bank</h2>
                <p class="text-light">Secure Login Portal</p>

                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="login-wrap p-0">
                    <form id="account" method="post">
                        <div class="form-group">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <input id="password-field" asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <span class="fa fa-fw fa-eye field-icon toggle-password" data-toggle="#password-field"></span>
                        </div>

                        <div class="form-group">
                            <button id="login-submit" type="submit" class="form-control btn btn-get-started submit px-3">Sign In</button>
                        </div>
                        <div class="form-group d-md-flex">
                            <div class="w-50">
                                @* <label asp-for="Input.RememberMe" class="form-label checkbox-wrap  checkbox-primary"> *@
                                @*     <input type="checkbox" class="form-check-input" asp-for="Input.RememberMe" /> *@
                                @*     <span class="checkmark"></span> *@
                                @*     @Html.DisplayNameFor(m => m.Input.RememberMe) *@
                                @* </label> *@

                            </div>
                            <div class="w-50 text-md-right">
                                <a class="checkbox-primary" id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</section>




@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


