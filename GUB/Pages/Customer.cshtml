@page
@model GUB.Pages.CustomerModel
@{
}




<section class="p-0">
    <div class="page-title" data-aos="fade">
        <div class="heading">
            <div class="container">
                <div class="row d-flex justify-content-center text-center">
                    <div class="col-lg-8">
                        <h1 class="display-4 fw-bold text-white text-uppercase">
                            Greater Unity Bank
                        </h1>
                        @foreach (var q in Model.ZenQuotes)
                        {
                            <p class="mb-0 p-3 border-start border-primary fs-5 fst-italic text-secondary">
                                "@q.Quote"
                                <span class="d-block text-end fw-bold text-dark">- @q.Author</span>
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="table-container" style="background-color: #f5f7fa;">
            <div class="mask d-flex align-items-center">
                <div class="container mt-5 mb-5">
                    <div class="row justify-content-center">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body p-0">
                                    <div class="table-responsive table-scroll" data-mdb-perfect-scrollbar="true" style="position: relative; height: 700px">
                                        <table class="table table-striped">
                                            <thead class="thead-green ">
                                                <tr>
                                                    <th scope="col"> Id</th>
                                                    <th scope="col">
                                                        First Name
                                                        <a asp-page="/Customer"
                                                           asp-route-sortColumn="First Name"
                                                           asp-route-sortOrder="asc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-up text-light"></i>

                                                        </a>
                                                        <a asp-page="/Customer"
                                                           asp-route-sortColumn="First Name"
                                                           asp-route-sortOrder="desc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-down text-light"></i>
                                                        </a>
                                                    </th>

                                                    <th scope="col">
                                                        Last Name
                                                        <a asp-page="/Customer"
                                                           asp-route-sortColumn="Last Name"
                                                           asp-route-sortOrder="asc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-up text-light"></i>

                                                        </a>
                                                        <a asp-page="/Customer"
                                                           asp-route-sortColumn="Last Name"
                                                           asp-route-sortOrder="desc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-down text-light"></i>
                                                        </a>
                                                    </th>


                                                    <th scope="col">
                                                        Country
                                                        <a asp-page="/Customer"
                                                           asp-route-sortColumn="Country"
                                                           asp-route-sortOrder="asc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-up text-light"></i>

                                                        </a>
                                                        <a asp-page="/Customer"
                                                           asp-route-sortColumn="Country"
                                                           asp-route-sortOrder="desc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-down text-light"></i>
                                                        </a>
                                                    </th>
                                                    <th>Details</th>
                                                </tr>
                                            </thead>

                                            <tbody>

                                                @foreach (var c in Model.Customers)
                                                {
                                                    <tr>
                                                        <td>@c.Id</td>
                                                        <td>@c.FirstName</td>
                                                        <td>@c.LastName</td>
                                                        <td>@c.Country</td>
                                                        <td><a asp-page="/Customer" asp-route-id="@c.Id" class="btn btn-primary">View</a></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-success btn-lg d-block mx-auto">
                        <span>Load more...</span>
                    </button>
                </div>
            </div>
        </div>
</section>

