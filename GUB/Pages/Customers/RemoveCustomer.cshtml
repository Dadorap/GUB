@page
@model GUB.Pages.Customers.RemoveCustomerModel
@{
}
<div class="grey-bg container-fluid">
    <form method="post">
        <section id="minimal-statistics" class="ml-3 mr-3">
            <div class="row">
                <div class="col-12">
                    <h2 class="text-uppercase border-bottom">Remove Account</h2>
                </div>
            </div>
            <div class="container d-flex flex-column justify-content-center align-content-center w-100">

                <div>
                    <a class="btn btn-success float-right m-4"
                       asp-area=""
                       asp-page="/Customers/CustomerDetails"
                       asp-route-id="@Model.CustomerId">
                        &lArr; Back
                    </a>
                    <div class="d-flex justify-content-center align-content-center">
                        <span class="field-validation-error text-danger fw-bold fs-5 m-4" asp-validation-for="RemoveValidation"></span>                       
                    </div>
                </div>
                @* row 2 *@
                <div class="row w-100">
                    @* Customer id *@
                    <div class="col-6">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="media-body text-left">
                                            <label asp-for="CustomerId" 
                                            class="d-block">Customer ID</label>
                                            <input asp-for="CustomerId" 
                                            class="form-control w-75 border" 
                                            value="@Model.CustomerId" readonly>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fa-solid fa-id-badge text-primary fa-3x float-right"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* customer full name *@
                    <div class="col-6">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="media-body text-left">
                                            <label asp-for="FullName"
                                                   class="d-block">Full Name</label>
                                            <input asp-for="FullName" 
                                            class="form-control w-75 border" 
                                            value="@Model.FullName" readonly>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fa-solid fa-user text-success fa-3x float-right"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <button class="btn btn-danger p-3 fw-bolder fs-4" type="submit">Remove</button>
            </div>
        </section>
    </form>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}