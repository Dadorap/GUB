@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}


<section class="ftco-section min-vh-100 min-vw-100 section hero dark-background">
    <img src="~/img/hero-bg.png" alt="" data-aos="fade-in">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 text-center mb-5">
                <h2 class="heading-section">Greater Unity Bank</h2>
                <p class="text-light">Password Recovery</p>

                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-md-4"> 
                <form method="post"> 
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div> 
                    <div class="form-group"> 
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />                         
                         <span asp-validation-for="Input.Email" class="text-danger"></span> 
                     </div>
                    <button type="submit" class="form-control btn btn-get-started submit px-3">Reset Password</button>
                </form> 
             </div> 
         </div> 
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
