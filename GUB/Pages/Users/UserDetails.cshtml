@page
@model GUB.Pages.Users.UserDetailsModel
@{
}

<div class="grey-bg container">
    <form method="post">
        <section id="minimal-statistics" class="ml-3 mr-3">
            <div class="row">
                <div class="col-12">
                    <h2 class="text-uppercase border-bottom">User Details Update</h2>
                </div>
                <div>
                    <h3 class="float-left m-4">
                       User ID: @Model.UserId
                        <input type="hidden" asp-for="UserId" />
                    </h3>
                    <a class="btn btn-success float-right m-4"
                       asp-area=""
                       asp-page="/Users/Index">
                        &lArr; Back
                    </a>
                </div>
            </div>

            <div class="row">
                @* Username (Email/LoginName) *@
                <div class="col-xl-6 col-sm-12 mb-3">
                    <div class="card">
                        <div class="card-body d-flex align-items-center">
                            <div class="flex-grow-1 me-3">
                                <label asp-for="LoginName" class="form-label">Username</label>
                                <input asp-for="LoginName" class="form-control border" />
                                <span class="text-danger" asp-validation-for="LoginName"></span>
                            </div>
                            <i class="fa-solid fa-envelope text-muted fa-2x"></i>
                        </div>
                    </div>
                </div>

                <div class="col-xl-6 col-sm-12 mb-3">
                    <div class="card">
                        <div class="card-body d-flex align-items-center">
                            <div class="flex-grow-1 me-3">
                                <label asp-for="Role" class="form-label">Role</label>
                                <select asp-for="Role" asp-items="Html.GetEnumSelectList<Role>()" class="form-controll rounded-5 w-75">
                                </select>                                
                                <span class="text-danger" asp-validation-for="Role"></span>
                            </div>
                            <i class="fa-solid fa-user-tag text-success fa-2x"></i>
                        </div>
                    </div>
                </div>



                
            </div>

            <button type="submit" asp-route-id="@Model.UserId" asp-page-handler="Update" class="btn btn-success">Update</button>
            <button type="submit" asp-route-id="@Model.UserId" asp-page-handler="Delete" class="btn btn-danger ml-2">Delete</button>


        </section>
    </form>
</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}