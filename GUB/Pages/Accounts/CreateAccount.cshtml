@page
@model GUB.Pages.Accounts.CreateAccountModel
@{
}
<div class="grey-bg container-fluid">
    <form method="post">
        <section id="minimal-statistics" class="ml-3 mr-3">
            <div class="row">
                <div class="col-12">
                    <h2 class="text-uppercase border-bottom">Create Account</h2>
                </div>
            </div>
            <div class="container d-flex flex-column justify-content-center align-content-center w-100">

                <div>
                    <a class="btn btn-success float-right m-4"
                       asp-area=""
                       asp-page="/Customers/CustomerDetails"
                       asp-route-id="@Model.CustomerId">
                        &lArr; Back
                    </a>
                </div>
                @* row 2 *@
                <div class="row w-100">

                    @* Customer id *@
                    <div class="col-6">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="media-body text-left">
                                            <label asp-for="CustomerId" class="d-block">Customer ID</label>
                                            <input asp-for="CustomerId" class="form-control w-75 border" value="@Model.CustomerId" disabled>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fa-solid fa-user  text-success fa-3x float-right"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Type *@
                    <div class="col-6">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="media-body text-left">
                                            <label asp-for="Type" class="d-block">Type</label>
                                            <input type="hidden" asp-for="Type" value="OWNER" />
                                            <input asp-for="Type" class="form-control w-75 border" value="@Model.Type" disabled>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fa-solid fa-user-tie text-success fa-3x float-right"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                @* row 2 *@
                <div class="row w-100">

                    @* Frequency *@
                    <div class="col-6">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="media-body text-left">
                                            <label asp-for="Frequency" class="d-block"></label>
                                            <select asp-for="Frequency" asp-items="Html.GetEnumSelectList<Frequency>()" class="form-controll rounded-5 w-75"></select>
                                            <span class="field-validation-error text-danger" asp-validation-for="Frequency"></span>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fa-solid fa-repeat text-muted fa-3x float-left"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Balance *@
                    <div class="col-6">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="media-body text-left">
                                            <label asp-for="Balance" class="d-block">Balance</label>
                                            <input asp-for="Balance" class="form-control w-75 border" value="@Model.Balance">
                                            <span class="field-validation-error text-danger" asp-validation-for="Balance"></span>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fa-solid fa-sack-dollar text-green fa-3x float-left"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>



                </div>
                <button class="btn btn-success p-3 fw-bolder fs-4" type="submit">Save</button>
            </div>
        </section>
    </form>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}