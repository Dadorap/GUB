@page
@using Newtonsoft.Json.Linq
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}


<div class="events-page">


    <main class="main">
        <!-- Page Title -->
        <div class="page-title" data-aos="fade">
            <div class="heading">
                <div class="container">
                    <div class="row d-flex justify-content-center text-center">
                        <div class="col-lg-8">
                            <h1 class ="display-4 fw-bold text-white text-uppercase">
                                Greater Unity Bank</h1>
                            @foreach (var q in Model.ZenQuotes){
                            <p class="mb-0 p-3 border-start border-primary fs-5 fst-italic text-secondary">
                                "@q.Quote"
                                <span class="d-block text-end fw-bold text-dark">- @q.Author</span>
                            </p>
                            }
                        </div>
                    </div>
                </div>
            </div>
            
        </div><!-- End Page Title -->

        <!-- Events Section -->
        <section id="events" class="events section min-vh-100">

            <div class="container" data-aos="fade-up">

                <div class="row">
                    <div class="col-md-6 d-flex align-items-stretch">
                        <div class="card">
                            <div class="card-img">
                                <img src="~/img/Flags/Flag_of_Sweden.svg.png" alt="...">
                            </div>
                            <div class="card-body dark-background">
                                <h2 class="card-title"><a href="">Sweden</a></h2>
                                <p class="fst-italic text-center text-light">@Model.DateOnly</p>
                                <div class="d-flex flex-wrap justify-content-center text-center">
                                    <!-- Total Transactions -->
                                    <div class="p-3 d-flex flex-column align-items-center">
                                        <i class="bi bi-cash-stack h2 text-light"></i>
                                        <h6 class="mt-2">Transactions</h6>
                                        <p class="fw-bold text-light">525550</p>
                                    </div>

                                    <!-- Total Balance -->
                                    <div class="p-3 d-flex flex-column align-items-center">
                                        <i class="bi bi-wallet2 h2 text-light"></i>
                                        <h6 class="mt-2">Balance</h6>
                                        <p class="fw-bold text-light">5550548 SEK</p>
                                    </div>

                                    <!-- Total Accounts -->
                                    <div class="p-3 d-flex flex-column align-items-center">
                                        <i class="bi bi-bank h2 text-light"></i>
                                        <h6 class="mt-2">Accounts</h6>
                                        <p class="fw-bold text-light">500</p>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex align-items-stretch">
                        <div class="card">
                            <div class="card-img">
                                <img src="~/img/Flags/Flag_of_Finland.svg.png" alt="...">
                            </div>
                            <div class="card-body">
                                <h5 class="card-title"><a href="">Introduction to webdesign</a></h5>
                                <p class="fst-italic text-center">Sunday, September 26th at 7:00 pm</p>
                                <p class="card-text">Lorem ipsum dolor sit amet, consectetur elit, sed do eiusmod tempor ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6 d-flex align-items-stretch">
                        <div class="card">
                            <div class="card-img">
                                <img src="~/img/Flags/Flag_of_Denmark.svg.png" alt="...">


                            </div>
                            <div class="card-body">
                                <h5 class="card-title"><a href="">Marketing Strategies</a></h5>
                                <p class="fst-italic text-center">Sunday, November 15th at 7:00 pm</p>
                                <p class="card-text">Sed ut perspiciatis unde omnis iste natus error sit voluptatem doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 d-flex align-items-stretch">
                        <div class="card">
                            <div class="card-img">
                                <img src="~/img/Flags/Flag_of_Norway.svg.png" alt="...">
                            </div>
                            <div class="card-body">
                                <h5 class="card-title"><a href="">Marketing Strategies</a></h5>
                                <p class="fst-italic text-center">Sunday, November 15th at 7:00 pm</p>
                                <p class="card-text">Sed ut perspiciatis unde omnis iste natus error sit voluptatem doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </section><!-- /Events Section -->

    </main>



</div>