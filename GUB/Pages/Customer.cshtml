@page
@model GUB.Pages.CustomerModel
@{
}

<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col"> Id</th>
            <th scope="col">
                First Name
                <a asp-page="/Customer"
                   asp-route-sortColumn="First Name"
                   asp-route-sortOrder="asc"
                   style="text-decoration:none">
                    <i class="fa-solid fa-angle-up"></i>

                </a>
                <a asp-page="/Customer"
                   asp-route-sortColumn="First Name"
                   asp-route-sortOrder="desc"
                   style="text-decoration:none">
                    <i class="fa-solid fa-angle-down"></i>
                </a>
            </th>

            <th scope="col">
                Last Name
                <a asp-page="/Customer"
                   asp-route-sortColumn="Last Name"
                   asp-route-sortOrder="asc"
                   style="text-decoration:none">
                    <i class="fa-solid fa-angle-up"></i>

                </a>
                <a asp-page="/Customer"
                   asp-route-sortColumn="Last Name"
                   asp-route-sortOrder="desc"
                   style="text-decoration:none">
                    <i class="fa-solid fa-angle-down"></i>
                </a>
            </th>


            <th scope="col">
                Country
                <a asp-page="/Customer"
                   asp-route-sortColumn="Country"
                   asp-route-sortOrder="asc"
                   style="text-decoration:none">
                    <i class="fa-solid fa-angle-up"></i>

                </a>
                <a asp-page="/Customer"
                   asp-route-sortColumn="Country"
                   asp-route-sortOrder="desc"
                   style="text-decoration:none">
                    <i class="fa-solid fa-angle-down"></i>
                </a>
            </th>



            <th>Details</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var c in Model.Customers)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.FirstName</td>
                <td>@c.LastName</td>
                <td>@c.Country</td>


                <td><a asp-page="/Customer" asp-route-id="@c.Id" class="btn btn-primary">View</a></td>
            </tr>
        }
    </tbody>
</table>