    ======================================================== -->
</head>

<body class="index-page">

    <header id="header" class="header d-flex align-items-center sticky-top">
        <div class="container-fluid container-xl position-relative d-flex align-items-center">


            <a asp-page="/Index" class="logo d-flex align-items-center me-auto">
                <!-- Uncomment the line below if you also wish to use an image logo -->
                <!-- <img src="assets/img/logo.png" alt=""> -->
                <img src="~/img/GUBLogo.png" alt="GUB logo" class="img-fluid">
                <h1 class="sitename">GUB </h1>
            </a>

            <nav id="navmenu" class="navmenu">
                <ul>
                    <li><a asp-area="" asp-page="/Index" class="active">Home<br></a></li>
                    <li><a asp-area="" asp-page="/Test" class="active">Test<br></a></li>

                    <!--  <li class="dropdown">
                                 <a href="#"><span>Dropdown</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                        <ul>
                             <li><a href="#">Dropdown 1</a></li>
                         </ul>
                    </li> -->
                    @if (User.IsInRole("Cashier"))
                    {
                        <li>
                            <a class="nav-link text-dark" asp-page="/Customers/Customer">Customers</a>
                        </li>
                        <li>
                            <a class="nav-link text-dark" asp-page="/Accounts/AccountIndex">Accounts</a>
                        </li>

                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li>
                            <a asp-area="Identity" asp-page="/Account/Register">Register</a>

                        </li>
                    }

                    @if (User.Identity.IsAuthenticated)
                    {
                        <partial name="_LoginPartial" />
                    }
                    else
                    {

                        <a class="btn btn-success d-inline-block px-4 py-2 rounded-pill text-white" asp-area="Identity" asp-page="/Account/Login">Sign In</a>
                        
                    }



                </ul>


                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            </nav>


        </div>
    </header>

    <main class="main">

        @RenderBody()
    </main>
    <!-- Footer -->
    <footer id="footer" class="footer position-relative light-background">
        <div class="container footer-top">
            <div class="row d-flex align-items-start">
                <div class="col-lg-6 col-md-6 footer-about">
                    <a asp-page="/Index" class="logo d-flex align-items-center">
                        <span class="sitename">Greater Unity Bank</span>
                    </a>
                    <div class="footer-contact pt-3">
                        <p>Nybrogatan</p>
                        <p>Härnsösand, 871 30</p>
                        <p class="mt-3"><strong>Phone:</strong> <span>077-125 25 25</span></p>
                        <p>
                            <strong>Email:</strong>
                            <a href="mailto:support@greaterunitybank.com">support@greaterunitybank.com</a>
                        </p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 footer-links mt-2">
                    <h4 class="mt-1">Useful Links</h4>
                    <ul>
                        <li><a asp-page="/Index">Home</a></li>
                        <li><a asp-page="/About">About us</a></li>
                        <li><a asp-page="/Contact">Contact Support</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="container copyright text-center mt-4">
            <p>© <span>Copyright</span> <strong class="px-1 sitename">Greater Unity Bank</strong> <span>All Rights Reserved</span></p>
            <div class="credits">
            </div>
        </div>
    </footer>

    <!-- Scroll Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Preloader -->
    <div id="preloader"></div>






    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/popper.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>




    <!-- Vendor JS Files -->
    <script src="~/vendor/php-email-form/validate.js"></script>
    <script src="~/vendor/aos/aos.js"></script>
    <script src="~/vendor/glightbox/js/glightbox.js"></script>
    <script src="~/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="~/vendor/swiper/swiper-bundle.min.js"></script>


    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof GLightbox !== "undefined") {
                const lightbox = GLightbox();
            } else {
                console.error("GLightbox is not loaded correctly.");
            }
        });
    </script>



    <!-- Main JS File -->
    <script src="~/vendor/js/main.js"></script>
    @RenderSection("Scripts", required: false)


</body>

</html>