@page
@using Newtonsoft.Json.Linq
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}


<div class="events-page">


    <main class="main">
        <!-- Page Title -->
        <div class="page-title" data-aos="fade">
            <div class="heading">
                <div class="container">
                    <div class="row d-flex justify-content-center text-center">
                        <div class="col-lg-8">
                            <h1 class="display-4 fw-bold text-white text-uppercase">
                                Greater Unity Bank
                            </h1>
                            @foreach (var q in Model.ZenQuotes)
                            {
                                <p class="mb-0 p-3 border-start border-primary fs-5 fst-italic text-secondary">
                                    "@q.Quote"
                                    <span class="d-block text-end fw-bold text-dark">- @q.Author</span>
                                </p>
                            }
                        </div>
                    </div>
                </div>
            </div>

        </div><!-- End Page Title -->
        <!-- Events Section -->
        <section id="events" class="events section min-vh-100">

            <div class="container" data-aos="fade-up">

                <div class="row">
                    @foreach (var c in Model.CountryCard)
                    {
                        <div class="col-md-6 d-flex align-items-stretch">
                            <div class="card">
                                <div class="card-img">
                                    <img src="@Url.Content($"~/img/Flags/Flag_of_{c.Country}.svg.png")" alt="Flag of @c.Country" />
                                </div>
                                <div class="card-body dark-background">
                                    <h2 class="card-title"><a style="cursor: default;">@c.Country</a></h2>
                                    <p class="fst-italic text-center text-light">@Model.DateOnly</p>
                                    <div class="d-flex flex-wrap justify-content-center text-center">

                                        <!-- Total Customers -->
                                        <div class="p-3 d-flex flex-column align-items-center">
                                            <i class="bi bi-person h2 text-light"></i>
                                            <h6 class="mt-2">Customers</h6>
                                            <p class="fw-bold text-light">@c.Customers</p>
                                        </div>

                                        <!-- Total Balance -->
                                        <div class="p-3 d-flex flex-column align-items-center">
                                            <i class="bi bi-wallet2 h2 text-light"></i>
                                            <h6 class="mt-2">Balance</h6>
                                            <p class="fw-bold text-light">@c.Balance Sek</p>
                                        </div>

                                        <!-- Total Transactions -->
                                        <div class="p-3 d-flex flex-column align-items-center">
                                            <i class="bi bi-bank h2 text-light"></i>
                                            <h6 class="mt-2">Accounts</h6>
                                            <p class="fw-bold text-light">@c.Accounts</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }                   
                </div>

            </div>

        </section>

    </main>



</div>