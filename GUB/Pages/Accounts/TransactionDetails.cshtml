@page
@model GUB.Pages.Accounts.TransactionDetailsModel
@{
}


<section class="p-0">
    <div class="page-title" data-aos="fade">
        <div class="heading">
            <div class="container">
                <div class="row d-flex justify-content-center text-center">
                    <div class="col-lg-8">
                        <h1 class="display-4 fw-bold text-white text-uppercase">
                            Greater Unity Bank
                        </h1>
                        @foreach (var q in Model.ZenQuotes)
                        {
                            <p class="mb-0 p-3 border-start border-primary fs-5 fst-italic text-secondary">
                                "@q.Quote"
                                <span class="d-block text-end fw-bold text-dark">- @q.Author</span>
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>


        <div class="table-container" style="background-color: #f5f7fa;">

            <div class="mask d-flex align-items-center flex-column">
                <div class="container">
                    <br />
                    <div class="row justify-content-center">

                        <div class="col-12 col-md-10 col-lg-8">
                            <form class="card card-sm" method="get">
                                <div class="card-body row no-gutters align-items-center">
                                    <div class="col-auto">
                                        <i class="fas fa-search"></i>
                                    </div>
                                    <!--end of col-->
                                    <div class="col text-dark">
                                        <input asp-for="@Model.Q" class="form-control form-control-lg
                                        form-control-borderless border-0" type="search"
                                               placeholder="Search Transaction ID or Date">
                                    </div>
                                    <!--end of col-->
                                    <div class="col-auto">
                                        <button class="btn btn-lg btn-success" type="submit">Search</button>
                                    </div>
                                    <!--end of col-->
                                </div>
                            </form>
                        </div>
                        <!--end of col-->
                    </div>
                    <div>
                        <h3 class=" text-dark float-left">Account ID: @Model.AccountId</h3>
                    </div>
                </div>

                <div class="w-50 h-100 mb-5 vw-70">
                    <div class="row justify-content-center">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body p-0">
                                    <div class="table-responsive table-scroll" data-mdb-perfect-scrollbar="true" style="position: relative; height: 700px">
                                        <table class="table table-striped">
                                            <thead class="thead-green">
                                                <tr>
                                                    @* transaction id *@
                                                    <th scope="col">
                                                        Trans. ID
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Transaction ID"
                                                           asp-route-sortOrder="asc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-up text-light"></i>

                                                        </a>
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Accout ID"
                                                           asp-route-sortOrder="desc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-down text-light"></i>
                                                        </a>
                                                    </th>                                                
                                                    @* Date *@
                                                    <th scope="col">
                                                        Date
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Date"
                                                           asp-route-sortOrder="asc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-up text-light"></i>

                                                        </a>
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Date"
                                                           asp-route-sortOrder="desc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-down text-light"></i>
                                                        </a>
                                                    </th>
                                                    @* Type *@
                                                    <th scope="col">
                                                        Date
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Type"
                                                           asp-route-sortOrder="asc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-up text-light"></i>

                                                        </a>
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Type"
                                                           asp-route-sortOrder="desc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-down text-light"></i>
                                                        </a>
                                                    </th>
                                                    @* Operation *@
                                                    <th scope="col">
                                                        Operation
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Operation"
                                                           asp-route-sortOrder="asc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-up text-light"></i>

                                                        </a>
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Operation"
                                                           asp-route-sortOrder="desc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-down text-light"></i>
                                                        </a>
                                                    </th>
                                                    @* Amount *@
                                                    <th scope="col">
                                                        Amount
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Amount"
                                                           asp-route-sortOrder="asc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-up text-light"></i>

                                                        </a>
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Amount"
                                                           asp-route-sortOrder="desc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-down text-light"></i>
                                                        </a>
                                                    </th>
                                                    @* Balance *@
                                                    <th scope="col">
                                                        Balance
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Balance"
                                                           asp-route-sortOrder="asc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-up text-light"></i>

                                                        </a>
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Balance"
                                                           asp-route-sortOrder="desc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-down text-light"></i>
                                                        </a>
                                                    </th>
                                                    @* Symbol *@
                                                    <th scope="col">
                                                        Symbol
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Symbol"
                                                           asp-route-sortOrder="asc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-up text-light"></i>

                                                        </a>
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Symbol"
                                                           asp-route-sortOrder="desc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-down text-light"></i>
                                                        </a>
                                                    </th>
                                                    @* Account *@
                                                    <th scope="col">
                                                        Account
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Account"
                                                           asp-route-sortOrder="asc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-up text-light"></i>

                                                        </a>
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Account"
                                                           asp-route-sortOrder="desc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-down text-light"></i>
                                                        </a>
                                                    </th>
                                                    @* Bank *@
                                                    <th scope="col">
                                                        Bank
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Bank"
                                                           asp-route-sortOrder="asc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-up text-light"></i>

                                                        </a>
                                                        <a asp-page="/Accounts/TransactionDetails"
                                                           asp-route-sortColumn="Bank"
                                                           asp-route-sortOrder="desc"
                                                           style="text-decoration:none">
                                                            <i class="fa-solid fa-angle-down text-light"></i>
                                                        </a>
                                                    </th>
                                                </tr>
                                            </thead>

                                            <tbody>

                                                @foreach (var c in Model.Transactions)
                                                {
                                                    <tr>
                                                        <td>@c.TransactionId</td>
                                                        <td>@c.Date</td>
                                                        <td>@c.Type</td>
                                                        <td class="fs-6">@c.Operation</td>
                                                        <td>@c.Amount</td>
                                                        <td>@c.Balance</td>
                                                        <td>@c.Symbol</td>
                                                        <td>@c.Account</td>
                                                        <td>@c.Bank</td>
                                                    </tr>
                                                }

                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
</section>
