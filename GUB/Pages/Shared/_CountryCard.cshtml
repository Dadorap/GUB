@model ViewModels.ViewModel.LandingPage.LandingPageCardViewModel


<div class="col-md-6 d-flex align-items-stretch">
    <div class="card">
        <div class="card-img">
            <img src="@Url.Content($"~/img/Flags/Flag_of_{@Model.Country}.svg.png")" alt="Flag of @Model.Country" />
        </div>
        <div class="card-body dark-background">
            <h2 class="card-title"><a style="cursor: default;">Model.Country</a></h2>
            <p class="fst-italic text-center text-light">@Model.Date</p>
            <div class="d-flex flex-wrap justify-content-center text-center">

                <!-- Total Customers -->
                <div class="p-3 d-flex flex-column align-items-center">
                    <i class="bi bi-person h2 text-light"></i>
                    <h6 class="mt-2">Customers</h6>
                    <p class="fw-bold text-light">@Model.Customers</p>
                </div>

                <!-- Total Balance -->
                <div class="p-3 d-flex flex-column align-items-center">
                    <i class="bi bi-wallet2 h2 text-light"></i>
                    <h6 class="mt-2">Balance</h6>
                    <p class="fw-bold text-light">@Model.Balance Sek</p>
                </div>

                <!-- Total Transactions -->
                <div class="p-3 d-flex flex-column align-items-center">
                    <i class="bi bi-bank h2 text-light"></i>
                    <h6 class="mt-2">Accounts</h6>
                    <p class="fw-bold text-light">@Model.Accounts</p>
                </div>
            </div>
        </div>
    </div>
</div>