@page
@model GUB.Pages.Customers.CustomerDetailsModel
@{
}
<div class="grey-bg container-fluid">
    @* customer details *@
    <section id="minimal-statistics" class="ml-3 mr-3">
        <div class="row">
            <div class="col-12">
                <h2 class="text-uppercase ">Customer Details</h2>
            </div>
            <div>
                <a class="btn btn-success float-right m-4" asp-area="" asp-page="/Customers/Customer">&lArr; Back </a>
                <a class="btn btn-success float-left m-4" asp-area="" asp-page="/Customers/UpdateCustomer">
                    <i class="fa-solid fa-pencil text-light"></i> EDIT
                </a>
            </div>
        </div>
        @* row 1 *@
        <div class="row">
            @* user *@
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="align-self-center">
                                    <i class="fa-solid fa-user  text-success fa-3x float-left"></i>
                                </div>
                                <div class="media-body text-right">
                                    <h3>Full Name</h3>
                                    <span>@Model.FullName</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* Emial *@
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="align-self-center">
                                    <i class="fa-solid fa-envelope text-muted fa-3x float-left"></i>
                                </div>
                                <div class="media-body text-right">
                                    <h3>E-Mail</h3>
                                    <span>@Model.Email</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @* phone number *@
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="align-self-center">
                                    <i class="fa-solid fa-mobile-screen-button text-primary fa-3x float-left"></i>
                                </div>
                                <div class="media-body text-right">
                                    <h3>Phone Number</h3>
                                    <span>@Model.PhoneNumber</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* address *@
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="align-self-center">
                                    <i class="fa-solid fa-location-dot text-danger fa-3x float-left"></i>
                                </div>
                                <div class="media-body text-right">
                                    <h3>Address</h3>
                                    <span>@Model.Address</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @* row 2 *@
        <div class="row">
            @* SSN *@
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="media-body text-left">
                                    <h3 class="danger">Social Security Number</h3>
                                    <span>@Model.SSN</span>
                                </div>
                                <div class="align-self-center">
                                    <i class="fa-solid fa-id-card text-primary fa-3x"></i>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* country/city *@
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="media-body text-left">
                                    <h3 class="warning">Country/City</h3>
                                    <span>@Model.Country / @Model.City</span>
                                </div>
                                <div class="align-self-center">
                                    <i class="fa-solid fa-city text-secondary fa-3x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @* birth date *@
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="media-body text-left">
                                    <h3 class="primary">Birth Date</h3>
                                    <span>@Model.BirthDate</span>
                                </div>
                                <div class="align-self-center">
                                    <i class="fa-solid fa-calendar-check text-success fa-3x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="media-body text-left">
                                    <h3 class="primary">Gender</h3>
                                    <span>@Model.Gender</span>
                                </div>
                                <div class="align-self-center">
                                    <i class="fa-solid fa-venus-mars text-warning fa-3x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* balance and accounts *@
    <section id="stats-subtitle" class="ml-3 mr-3">
        <div class="row">
            <div class="col-12 mt-3 mb-1">
                <h2 class="text-uppercase">Accounts & Balance</h2>
            </div>
        </div>

        <div class="row">
            @* accounts *@
            <div class="col-xl-6 col-md-12">
                <div class="card overflow-hidden">
                    <div class="card-content">
                        <div class="card-body cleartfix">

                            @foreach (var acc in Model.Account)
                            {
                                <div class="media align-items-stretch border-bottom">
                                    <div class="media-body">
                                        <h4>Account Number</h4>
                                        <span>@acc.AccountNumber</span>
                                    </div>
                                    <div class="media-body d-flex flex-column align-items-start justify-content-evenly">
                                        <a asp-page="/Customers/Deposit" asp-route-id="@acc.AccountId" class="text-success text-decoration-none">
                                            <i class="fa-solid fa-circle-plus"></i> Deposit
                                        </a>
                                        <a asp-page="/Customers/Withdraw" class="text-danger text-decoration-none">
                                            <i class="fa-solid fa-circle-minus"></i> Withdraw
                                        </a>
                                    </div>

                                    <div class="text-end">
                                        <h4>Balance</h4>
                                        <span class="text-green fs-3">@acc.Balance</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-6 col-md-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body cleartfix">
                            <div class="media align-items-stretch">
                                <div class="align-self-center">
                                    <i class="icon-speech warning font-large-2 mr-2"></i>
                                </div>
                                <div class="media-body align-self-center">
                                    <h1 class="font-weight-bolder">Total Balance</h1>
                                </div>
                                <div class="align-self-center">
                                    <h1 class="text-success fw-bolder">@Model.TotalBalance</h1>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


    </section>
</div>