@page
@using Newtonsoft.Json.Linq
@model GUB.Pages.TestModel
@{
}

<div class="grey-bg container-fluid">
    @* customer details *@
    <section id="minimal-statistics" class="ml-3 mr-3">
        <div class="row">
            <div class="col-12">
                <h2 class="text-uppercase ">Customer Details</h2>            
            </div>
            <div>
                <a class="btn btn-success float-right m-4" asp-area="" asp-page="/Customer">&lArr; Back </a>
            </div>
        </div>
        @* row 1 *@
        <div class="row">
            @* user *@
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="align-self-center">
                                    <i class="fa-solid fa-user  text-success fa-3x float-left"></i>
                                </div>
                                <div class="media-body text-right">
                                    <h3>Full Name</h3>
                                    <span>@Model.FullName</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* Emial *@
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="align-self-center">
                                    <i class="fa-solid fa-envelope text-muted fa-3x float-left"></i>
                                </div>
                                <div class="media-body text-right">
                                    <h3>E-Mail</h3>
                                    <span>HannaStormo@rhyta.com</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @* phone number *@
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="align-self-center">
                                    <i class="fa-solid fa-mobile-screen-button text-primary fa-3x float-left"></i>
                                </div>
                                <div class="media-body text-right">
                                    <h3>Phone Number</h3>
                                    <span>076-558 88 88</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* address *@
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="align-self-center">
                                    <i class="fa-solid fa-location-dot text-danger fa-3x float-left"></i>
                                </div>
                                <div class="media-body text-right">
                                    <h3>Address</h3>
                                    <span>Kings street 65, 851 66</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @* row 2 *@
        <div class="row">
            @* SSN *@
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="media-body text-left">
                                    <h3 class="danger">Social Security Number</h3>
                                    <span>500315-6933</span>
                                </div>
                                <div class="align-self-center">
                                    <i class="fa-solid fa-id-card text-primary fa-3x"></i>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* country/city *@
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="media-body text-left">
                                    <h3 class="warning">Country/City</h3>
                                    <span>Sweden / Härnösand</span>
                                </div>
                                <div class="align-self-center">
                                    <i class="fa-solid fa-city text-secondary fa-3x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @* birth date *@
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="media-body text-left">
                                    <h3 class="primary">Birth Date</h3>
                                    <span>1985-03-05</span>
                                </div>
                                <div class="align-self-center">
                                    <i class="fa-solid fa-calendar-check text-success fa-3x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>            
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="media-body text-left">
                                    <h3 class="primary">Gender</h3>
                                    <span>Female</span>
                                </div>
                                <div class="align-self-center">
                                    <i class="fa-solid fa-venus-mars text-warning fa-3x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* balance and accounts *@
    <section id="stats-subtitle" class="ml-3 mr-3">
        <div class="row">
            <div class="col-12 mt-3 mb-1">
                <h2 class="text-uppercase">Accounts & Balance</h2>
            </div>
        </div>

        <div class="row">
            @for(int i= 0; i < 5; i++){
                @* accounts *@
                <div class="col-xl-6 col-md-12">
                    <div class="card overflow-hidden">
                        <div class="card-content">
                            <div class="card-body cleartfix">
                                <div class="media align-items-stretch">
                                    <div class="align-self-center">
                                        <i class="icon-pencil primary font-large-2 mr-2"></i>
                                    </div>
                                    <div class="media-body">
                                        <h4>Account ID</h4>
                                        <span>@(i+235)</span>
                                    </div>
                                    <div class="align-self-center">
                                        <h1>18,000</h1>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="col-xl-6 col-md-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body cleartfix">
                            <div class="media align-items-stretch">
                                <div class="align-self-center">
                                    <i class="icon-speech warning font-large-2 mr-2"></i>
                                </div>
                                <div class="media-body align-self-center">
                                    <h1>Total Balance</h1>
                                </div>
                                <div class="align-self-center">
                                    <h1 class="text-success">84,695</h1>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


    </section>
</div>